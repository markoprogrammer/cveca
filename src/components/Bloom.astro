---
// The Cveca flower: five petals and a coral heart.
// open="load" blooms petal by petal when the page loads; open="view" waits until
// src/scripts/animations.ts adds .is-open (on view, or at the end of the story).
interface Props {
  class?: string;
  petal?: string;
  heart?: string;
  open?: "load" | "view";
  delay?: number;
}
const { class: className = "", petal = "var(--color-plum)", heart = "var(--color-coral)", open, delay = 0 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  class:list={["bloom", open && `bloom-${open}`, className]}
  style={`--d:${delay}ms`}
  data-bloom={open === "view" ? "" : undefined}
  aria-hidden="true"
>
  {[0, 72, 144, 216, 288].map((r, i) => <ellipse cx="12" cy="6.6" rx="3.7" ry="5.1" fill={petal} style={`--r:${r}deg;--i:${i}`} />)}
  <circle cx="12" cy="12" r="2.8" fill={heart} />
</svg>
