---
import type { Crumb } from "../data/seo";

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Putanja" class="mb-6 text-[13px] text-ink-3">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      items.map((c, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i < items.length - 1 ? (
            <a href={c.path} class="transition-colors hover:text-plum">
              {c.name}
            </a>
          ) : (
            <span aria-current="page" class="text-ink-2">
              {c.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
