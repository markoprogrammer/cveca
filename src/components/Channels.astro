---
// The four ways to write (Viber, SMS, WhatsApp, email) as buttons.
// With form, each link gets data-send so the inquiry script can fill in the composed message.
// Instagram follows across the full width: on its own a link to the profile; with form, two steps,
// copy the message and then open a direct message, because Instagram cannot take the text itself.
import { CHANNELS, INSTAGRAM } from "../data/channels";

interface Props {
  form?: boolean;
}
const { form = false } = Astro.props;
const button =
  "flex items-center gap-3 rounded-[16px] bg-white px-4 py-3.5 text-[16px] font-semibold shadow-[inset_0_0_0_1.5px_var(--color-line)] transition-shadow hover:shadow-[inset_0_0_0_1.5px_var(--color-ink)]";
const step =
  "flex w-full items-center gap-3 rounded-[12px] bg-mist px-4 py-3 text-left text-[15px] font-semibold transition-colors hover:bg-mist-2";
---

<div class="grid grid-cols-2 gap-3">
  {
    form && (
      <p class="col-span-2 text-[14px] text-ink-2">
        <strong class="font-semibold text-ink">Jedan klik</strong>: poruka se automatski prenosi.
      </p>
    )
  }
  {
    CHANNELS.map((c) => (
      <a
        href={c.href}
        data-send={form ? c.id : undefined}
        target={c.external ? "_blank" : undefined}
        rel={c.external ? "noopener" : undefined}
        class={button}
      >
        <svg viewBox="0 0 24 24" class="size-6 shrink-0" fill={c.color} aria-hidden="true">
          <path d={c.path} />
        </svg>
        {c.label}
      </a>
    ))
  }
  {
    form ? (
      <div class="col-span-2 rounded-[16px] bg-white p-4 shadow-[inset_0_0_0_1.5px_var(--color-line)]">
        <p class="flex items-center gap-3 text-[16px] font-semibold">
          <svg viewBox="0 0 24 24" class="size-6 shrink-0" fill={INSTAGRAM.color} aria-hidden="true">
            <path d={INSTAGRAM.path} />
          </svg>
          Instagram <span class="font-medium text-ink-3">{INSTAGRAM.label}</span>
        </p>
        <p class="mt-1.5 text-[14px] text-ink-2">Instagram ne prima gotov tekst, zato u dva koraka:</p>
        <div class="mt-3 grid gap-2">
          <button type="button" data-ig-copy class={step}>
            <span class="grid size-6 shrink-0 place-items-center rounded-full bg-sage text-[13px] text-white">1</span>
            <span data-ig-copy-label>Kopirajte poruku</span>
          </button>
          <a href={INSTAGRAM.dm} data-send="instagram" target="_blank" rel="noopener" class={step}>
            <span class="grid size-6 shrink-0 place-items-center rounded-full bg-sage text-[13px] text-white">2</span>
            Pošaljite u DM
          </a>
        </div>
      </div>
    ) : (
      <a href={INSTAGRAM.profile} target="_blank" rel="noopener" class:list={[button, "col-span-2"]}>
        <svg viewBox="0 0 24 24" class="size-6 shrink-0" fill={INSTAGRAM.color} aria-hidden="true">
          <path d={INSTAGRAM.path} />
        </svg>
        Instagram <span class="font-medium text-ink-3">{INSTAGRAM.label}</span>
      </a>
    )
  }
</div>
