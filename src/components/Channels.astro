---
// The four ways to write (Viber, SMS, WhatsApp, email) as buttons.
// With form, each link gets data-send so the inquiry script can fill in the composed message.
// With instagram, a full-width Instagram button follows (it cannot take a composed message).
import { CHANNELS, INSTAGRAM } from "../data/channels";

interface Props {
  form?: boolean;
  instagram?: boolean;
}
const { form = false, instagram = false } = Astro.props;
const button =
  "flex items-center gap-3 rounded-[16px] bg-white px-4 py-3.5 text-[16px] font-semibold shadow-[inset_0_0_0_1.5px_var(--color-line)] transition-shadow hover:shadow-[inset_0_0_0_1.5px_var(--color-ink)]";
---

<div class="grid grid-cols-2 gap-3">
  {
    CHANNELS.map((c) => (
      <a
        href={c.href}
        data-send={form ? c.id : undefined}
        target={c.external ? "_blank" : undefined}
        rel={c.external ? "noopener" : undefined}
        class={button}
      >
        <svg viewBox="0 0 24 24" class="size-6 shrink-0" fill={c.color} aria-hidden="true">
          <path d={c.path} />
        </svg>
        {c.label}
      </a>
    ))
  }
  {
    instagram && (
      <a href={INSTAGRAM.href} target="_blank" rel="noopener" class:list={[button, "col-span-2"]}>
        <svg viewBox="0 0 24 24" class="size-6 shrink-0" fill={INSTAGRAM.color} aria-hidden="true">
          <path d={INSTAGRAM.path} />
        </svg>
        Instagram <span class="font-medium text-ink-3">{INSTAGRAM.label}</span>
      </a>
    )
  }
</div>
