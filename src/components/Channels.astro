---
// The four ways to write (Viber, SMS, WhatsApp, email) as buttons.
// With form, each link gets data-send so the inquiry script can fill in the composed message.
import { CHANNELS } from "../data/channels";

interface Props {
  form?: boolean;
}
const { form = false } = Astro.props;
---

<div class="grid grid-cols-2 gap-3">
  {
    CHANNELS.map((c) => (
      <a
        href={c.href}
        data-send={form ? c.id : undefined}
        target={c.external ? "_blank" : undefined}
        rel={c.external ? "noopener" : undefined}
        class="flex items-center gap-3 rounded-[16px] bg-white px-4 py-3.5 text-[16px] font-semibold shadow-[inset_0_0_0_1.5px_var(--color-line)] transition-shadow hover:shadow-[inset_0_0_0_1.5px_var(--color-ink)]"
      >
        <svg viewBox="0 0 24 24" class="size-6 shrink-0" fill={c.color} aria-hidden="true">
          <path d={c.path} />
        </svg>
        {c.label}
      </a>
    ))
  }
</div>
