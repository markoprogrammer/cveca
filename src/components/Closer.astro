---
import LazyImg from "./LazyImg.astro";
// Unikat Nº 6 on the garden swing: the whole scene as the card, then two high-resolution landscape crops
// from the camera originals (scripts/zoom-crops.mjs) that stay sharp full screen.
import studio from "../assets/buketi/buket-06/dsc_7520.jpg";
import closer from "../assets/zoom/buket-06-ljuljaska.jpg";
import macro from "../assets/zoom/buket-06-detalj.jpg";

const layers = [
  { src: studio, alt: "Buket sa zevalicama, eustomom, hrizantemama i karanfilima na drvenoj ljuljašci u bašti", widths: [640, 1080, 1600, 2200] },
  { src: closer, alt: "Isti buket izbliza: koralne zevalice, žute i bele hrizanteme, ljubičasta eustoma i roze karanfil", widths: [800, 1280, 1920, 2560, 3000] },
  { src: macro, alt: "Detalj: bela hrizantema, ljubičasta eustoma, žuta hrizantema i zelena loptica karanfila", widths: [800, 1280, 1920, 2560, 3200] },
];
const captions = [
  { title: "Sezonsko cveće.", text: "Biram ono što je te nedelje najlepše na pijaci." },
  { title: "Složeno ručno, po osećaju.", text: "Bez šablona, bez pravila, bez kopiranja." },
  { title: "Unikat. Svaki put.", text: "Kad ga jednom poklonite, drugog takvog nema." },
];
---

<!-- Pinned scene: a studio shot opens from a card to full screen and the camera walks in to the petals. Driven by src/scripts/animations.ts. -->
<section data-closer class="closer relative bg-lilac text-ink" aria-labelledby="closer-title">
  <div class="closer-stage relative h-[100svh] overflow-hidden">
    <h2 id="closer-title" data-closer-title class="t-h2 absolute inset-x-0 top-[8vh] z-10 px-5 text-center">
      Pogledajte izbliza<span class="dot">.</span>
    </h2>
    <div data-closer-frame class="closer-frame absolute left-1/2 top-1/2 h-full w-full overflow-hidden">
      {
        layers.map((l) => (
          <LazyImg src={l.src} alt={l.alt} widths={l.widths} sizes="100vw" quality={72} defer="view" class="closer-layer absolute inset-0 size-full object-cover" />
        ))
      }
      <div data-closer-scrim class="absolute inset-0 bg-gradient-to-t from-aubergine/85 via-aubergine/10 to-transparent"></div>
    </div>
    <div class="absolute inset-x-0 bottom-[9vh] z-10 mx-auto flex max-w-[1068px] flex-col gap-6 px-5 text-white">
      {
        captions.map((c) => (
          <div data-closer-cap class="closer-cap [.js_&]:absolute [.js_&]:inset-x-5 [.js_&]:bottom-0">
            <p class="t-h2">{c.title}</p>
            <p class="mt-3 max-w-[520px] text-[19px] font-semibold leading-snug text-white/75 sm:text-[24px]">{c.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
