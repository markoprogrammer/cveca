---
import Logo from "./Logo.astro";
import { CONTACT } from "../data/site";
---

<footer class="dark bg-aubergine text-[15px] text-white/65">
  <div class="mx-auto max-w-[1120px] px-5 pb-10 pt-16 sm:pt-20">
    <div class="grid gap-12 sm:grid-cols-2 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <a href="#top" class="inline-block" aria-label="Cveca, na vrh stranice"><Logo tone="dark" defs={false} class="h-[76px] w-auto" /></a>
        <p class="mt-2 text-[13px] tracking-[0.06em] text-white/55">autorski cvetni aranžmani</p>
        <p class="mt-5 max-w-[340px] text-[21px] font-bold leading-snug tracking-[-0.03em] text-white">Luksuz sa osmehom.</p>
        <p class="mt-3 max-w-[340px]">Unikatni cvetni aranžmani od sezonskog cveća. Cveće za firme i poklon aranžmani u Beogradu.</p>
      </div>
      <nav aria-label="Stranice">
        <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-orchid">Stranice</p>
        <ul class="mt-3 space-y-1">
          <li><a href="/unikati/" class="text-white hover:text-orchid">Unikati</a></li>
          <li><a href="/cvece-za-firme/" class="text-white hover:text-orchid">Cveće za firme</a></li>
          <li><a href="/poklon-aranzmani/" class="text-white hover:text-orchid">Poklon aranžmani</a></li>
          <li><a href="/#prica" class="text-white hover:text-orchid">O meni</a></li>
        </ul>
      </nav>
      <address class="not-italic">
        <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-orchid">Preuzimanje</p>
        <p class="mt-3 text-white">{CONTACT.street}<br />{CONTACT.neighborhood}, {CONTACT.postalCode} {CONTACT.city}</p>
        <a href={CONTACT.maps} class="link mt-2" rel="noopener" target="_blank">Otvori u mapama</a>
      </address>
      <div>
        <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-orchid">Kontakt</p>
        <p class="mt-3"><a href={CONTACT.phoneHref} class="text-white hover:text-orchid">{CONTACT.phone}</a></p>
        <p><a href={`mailto:${CONTACT.email}`} class="text-white hover:text-orchid">{CONTACT.email}</a></p>
        <p><a href={CONTACT.instagram} target="_blank" rel="noopener" class="text-white hover:text-orchid">Instagram {CONTACT.instagramHandle}</a></p>
      </div>
    </div>
    <div class="mt-14 flex flex-col gap-3 border-t border-white/10 pt-6 text-[13px] text-white/45 sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} Cveca · Žarkovo, Beograd</p>
      <p>Fotografije su primeri ranijih aranžmana. Svaki aranžman je unikat.</p>
    </div>
  </div>
</footer>
