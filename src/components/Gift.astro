---
import { Image } from "astro:assets";
import sunflower from "../assets/buketi/buket-01/dsc_7442.jpg";
import Scribble from "./Scribble.astro";
import { CONTACT } from "../data/site";

const steps = [
  { n: "1", title: "Pošaljite upit", text: "Izaberite datum i recite mi kome je poklon i kakav je to čovek." },
  { n: "2", title: "Slažem samo za vas", text: "Od sezonskog cveća, po osećaju. Narudžbine najmanje 48 sati unapred." },
  { n: "3", title: "Preuzimanje ili dostava", text: `Lično u Žarkovu, ${CONTACT.street}, ili dostava po dogovoru.` },
];
---

<section id="poklon" class="py-24 sm:py-40">
  <div class="mx-auto max-w-[1120px] px-5">
    <p data-reveal class="tag">Poklon aranžmani po narudžbini</p>
    <h2 data-reveal class="t-h2 mt-5">Poklon koji se <Scribble><span class="accent">pamti<span class="dot">.</span></span></Scribble></h2>
    <p data-reveal class="t-intro mt-5 max-w-[680px]">
      Za ljude koji žele da poklone <strong>nešto zaista jedinstveno</strong>. Recite mi kome je namenjen, a ostalo prepustite meni i sezonskom cveću.
    </p>
  </div>

  <div data-reveal class="mx-auto mt-14 max-w-[1280px] px-5 sm:mt-20">
    <div class="overflow-hidden rounded-[32px] sm:rounded-[48px]">
      <Image
        src={sunflower}
        alt="Poklon aranžman sa suncokretom, eustomom, zevalicama i alstremerijama"
        widths={[640, 1080, 1600, 2200]}
        sizes="(min-width: 1280px) 1240px, 100vw"
        format="webp" quality={72}
        data-parallax
        class="block aspect-[4/5] w-full scale-110 object-cover sm:aspect-[16/9]"
      />
    </div>
  </div>

  <div class="mx-auto max-w-[1120px] px-5">
    <ol data-stagger class="mt-14 grid gap-10 sm:mt-20 md:grid-cols-3 md:gap-8">
      {
        steps.map((s) => (
          <li data-reveal class="rounded-[28px] bg-lilac p-7">
            <span class="grid size-11 place-items-center rounded-full bg-coral text-[17px] font-bold text-white">{s.n}</span>
            <p class="mt-4 text-[21px] font-semibold tracking-[-0.02em]">{s.title}</p>
            <p class="mt-2 text-[17px] text-ink-2">{s.text}</p>
          </li>
        ))
      }
    </ol>
    <div data-reveal class="mt-14 flex flex-wrap items-center gap-x-7 gap-y-4">
      <a href={CONTACT.phoneHref} class="btn btn-primary">Pozovite i naručite</a>
      <a href="#upit" data-mode="poklon" class="link">ili pošaljite upit</a>
    </div>
  </div>
</section>
