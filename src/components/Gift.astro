---
import { Image } from "astro:assets";
import basket from "../assets/buketi/buket-09/dsc_7535.jpg";
import swing from "../assets/buketi/buket-07/dsc_7536.jpg";
import { CONTACT } from "../data/site";

const steps = [
  { n: "1", title: "Pošaljite upit", text: "Izaberite datum i recite mi kome je poklon i kakav je to čovek." },
  { n: "2", title: "Slažem samo za vas", text: "Od sezonskog cveća, po osećaju. Narudžbine najmanje 48 sati unapred." },
  { n: "3", title: "Preuzimanje ili dostava", text: `Lično u Žarkovu, ${CONTACT.street}, ili dostava po dogovoru.` },
];
---

<section id="poklon" class="overflow-hidden py-24 sm:py-40">
  <div class="mx-auto grid max-w-[1120px] items-center gap-16 px-5 lg:grid-cols-2 lg:gap-20">
    <!-- Two garden-swing photos: the gift basket in a large arch, a second arrangement drifting over its corner. -->
    <div class="relative mx-auto w-full max-w-[500px] pb-16 pr-10 sm:pr-16 lg:mx-0">
      <div data-reveal="photo" class="arch overflow-hidden">
        <Image
          src={basket}
          alt="Poklon aranžman u korpi od jute sa eustomom, karanfilima i proteom, na drvenoj ljuljašci u bašti"
          widths={[460, 690, 920]}
          sizes="(min-width: 1024px) 440px, 85vw"
          format="webp"
          quality={76}
          data-parallax
          class="arch block aspect-[4/5] w-full scale-110 object-cover"
        />
      </div>
      <div class="drift-card absolute bottom-0 right-0 w-[44%]">
        <div data-reveal="photo" class="arch overflow-hidden shadow-[0_30px_60px_-24px_rgb(29_16_34/0.45)] ring-[6px] ring-white">
          <Image
            src={swing}
            alt="Aranžman sa suncokretom, eustomom i gladiolama na ljuljašci"
            widths={[240, 360, 480]}
            sizes="220px"
            format="webp"
            quality={76}
            class="arch block aspect-[3/4] w-full object-cover"
          />
        </div>
      </div>
    </div>

    <div>
      <p class="tag">Poklon aranžmani po narudžbini</p>
      <h2 data-reveal class="t-h2 mt-5">Poklon koji se pamti<span class="dot">.</span></h2>
      <p class="t-intro mt-5 max-w-[520px]">
        Za ljude koji žele da poklone <strong>nešto zaista jedinstveno</strong>. Recite mi kome je namenjen, a ostalo prepustite meni i sezonskom cveću.
      </p>
      <ol class="mt-10 border-b border-line">
        {
          steps.map((s) => (
            <li class="flex gap-5 border-t border-line py-5">
              <span class="w-7 shrink-0 pt-px text-[15px] font-semibold tabular-nums text-plum">0{s.n}</span>
              <div>
                <p class="text-[17px] font-bold tracking-[-0.02em]">{s.title}</p>
                <p class="mt-1 text-[17px] text-ink-2">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a href={CONTACT.phoneHref} class="btn btn-primary">Pozovite i naručite</a>
        <a href="#upit" data-mode="poklon" class="link">ili pošaljite upit</a>
      </div>
    </div>
  </div>
</section>
