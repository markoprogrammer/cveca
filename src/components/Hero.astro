---
import { Image } from "astro:assets";
import Scribble from "./Scribble.astro";
import LazyImg from "./LazyImg.astro";
import { bouquets } from "../data/bouquets";

// Studio shots side by side, each in an arch: the claim ("nema dva ista") and its proof in one view.
// The most striking one sits in the middle, where the row starts centered.
const order = [2, 3, 7, 6, 5, 11, 8, 1, 10];
const lineup = order.map((n) => bouquets.find((b) => b.title.endsWith(` ${n}`))!);
const archClass =
  "arch block aspect-[2/3] h-[clamp(300px,52vh,540px)] w-auto object-cover transition-transform duration-[1200ms] ease-out-expo group-hover:scale-[1.04]";
---

<section id="top" data-hero class="relative isolate overflow-hidden pb-16 pt-16 sm:pb-24 sm:pt-24">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[90%] bg-[radial-gradient(60%_55%_at_50%_0%,var(--color-lilac-2),transparent_70%),radial-gradient(30%_30%_at_80%_20%,rgb(255_106_69/0.1),transparent_70%)]"
    aria-hidden="true"
  >
  </div>
  <div data-hero-copy class="mx-auto max-w-[1000px] px-5 text-center">
    <h1>
      <span class="rise tag" style="--i:0">Unikatni cvetni aranžmani · Žarkovo, Beograd</span>
      <span class="rise t-hero mt-6 block" style="--i:1">Nema dva <Scribble draw="load"><span class="accent">ista<span class="dot">.</span></span></Scribble></span>
    </h1>
    <p class="rise t-intro mx-auto mt-6 max-w-[620px]" style="--i:2">
      Veliki, bogati aranžmani od sezonskog cveća, složeni ručno i po osećaju. <strong>Svakog ponedeljka za vašu firmu</strong>, ili kao poklon koji
      se pamti.
    </p>
    <div class="rise mt-9 flex flex-wrap items-center justify-center gap-3" style="--i:3">
      <a href="#firme" class="btn btn-primary">Cveće za firme</a>
      <a href="#poklon" class="btn btn-ghost">Poklon aranžman</a>
    </div>
  </div>

  <div class="mt-16 sm:mt-20">
    <ul data-lineup class="lineup flex w-max items-end gap-4 px-5 will-change-transform sm:gap-6">
      {
        lineup.map((b, i) => (
          <li class="rise" style={`--i:${3 + Math.abs(i - 4) * 0.6}`}>
            <button
              type="button"
              data-open={b.id}
              data-index="0"
              aria-label={`${b.title}, pogledaj fotografije`}
              class="group block rounded-t-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-plum"
            >
              <span class="arch block overflow-hidden bg-lilac">
                {
                  i === 4 ? (
                    <Image
                      src={b.photos[0]}
                      alt={`${b.title}, ${b.vessel.toLowerCase()}: ${b.flowers.toLowerCase()}`}
                      widths={[240, 360, 540, 720]}
                      sizes="(min-width: 640px) 340px, 56vw"
                      format="webp"
                      loading="eager"
                      fetchpriority="high"
                      class={archClass}
                    />
                  ) : (
                    <LazyImg
                      src={b.photos[0]}
                      alt={`${b.title}, ${b.vessel.toLowerCase()}: ${b.flowers.toLowerCase()}`}
                      widths={[240, 360, 540, 720]}
                      sizes="(min-width: 640px) 340px, 56vw"
                      defer="load"
                      class={archClass}
                    />
                  )
                }
              </span>
              <span class="mt-4 block text-center text-[14px] font-semibold text-ink-2 transition-colors group-hover:text-plum">{b.title}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>
