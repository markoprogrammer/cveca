---
import { Image } from "astro:assets";
import LazyImg from "./LazyImg.astro";
import Scribble from "./Scribble.astro";
import { bouquets } from "../data/bouquets";

// Every bouquet as a studio shot in an arch, in one row you can swipe through: the claim
// ("nema dva ista") and its proof side by side. Tapping one opens all its photos.
const archClass =
  "arch block aspect-[2/3] h-[clamp(300px,50vh,520px)] w-auto object-cover transition-transform duration-[1200ms] ease-out-expo group-hover:scale-[1.03]";
---

<!-- Opening: the bouquets arrive first, large, where the headline will be; then the row glides down to its place as the words appear above it (CSS, see .intro-* in global.css). -->
<section id="top" class="intro overflow-x-clip pb-20 pt-16 sm:pb-28 sm:pt-24">
  <div class="mx-auto max-w-[1000px] px-5 text-center">
    <h1>
      <span class="intro-copy tag" style="--i:0">Unikatni cvetni aranžmani · Žarkovo, Beograd</span>
      <span class="intro-copy t-hero mt-5 block" style="--i:1">Nema dva <Scribble draw="load"><span class="accent">ista<span class="dot">.</span></span></Scribble></span>
    </h1>
    <p class="intro-copy t-intro mx-auto mt-6 max-w-[600px]" style="--i:2">
      Veliki, bogati aranžmani od sezonskog cveća, složeni ručno i po osećaju. <strong>Svakog ponedeljka za vašu firmu</strong>, ili kao poklon koji
      se pamti.
    </p>
    <div class="intro-copy mt-9 flex flex-wrap items-center justify-center gap-3" style="--i:3">
      <a href="#firme" class="btn btn-primary">Cveće za firme</a>
      <a href="#poklon" class="btn btn-ghost">Poklon aranžman</a>
    </div>
  </div>

  <div id="unikati" class="mt-16 scroll-mt-24 sm:mt-24">
    <ul data-track-row class="intro-row no-scrollbar snap-row relative z-10 flex gap-4 overflow-x-auto pb-2 sm:gap-6" aria-label="Unikati">
      {
        bouquets.map((b, i) => (
          <li class="intro-card shrink-0" style={`--i:${Math.min(i, 5)}`}>
            <button
              type="button"
              data-open={b.id}
              data-index="0"
              aria-label={`${b.title} ${b.vessel}, pogledajte fotografije`}
              class="group block text-left focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sage"
            >
              <span class="arch block overflow-hidden bg-mist">
                {
                  i < 3 ? (
                    <Image
                      src={b.photos[0]}
                      alt={`${b.title}, ${b.vessel.toLowerCase()}: ${b.flowers.toLowerCase()}`}
                      widths={[240, 360, 540, 720]}
                      sizes="(min-width: 640px) 350px, 66vw"
                      format="webp"
                      loading={i === 0 ? "eager" : "lazy"}
                      fetchpriority={i === 0 ? "high" : undefined}
                      class={archClass}
                    />
                  ) : (
                    <LazyImg
                      src={b.photos[0]}
                      alt={`${b.title}, ${b.vessel.toLowerCase()}: ${b.flowers.toLowerCase()}`}
                      widths={[240, 360, 540, 720]}
                      sizes="(min-width: 640px) 350px, 66vw"
                      defer="load"
                      class={archClass}
                    />
                  )
                }
              </span>
              <span class="mt-4 block px-1 text-[16px] font-semibold tracking-[-0.015em] transition-colors group-hover:text-sage">{b.title}</span>{" "}
              <span class="block px-1 text-[15px] text-ink-3">{b.vessel}</span>
            </button>
          </li>
        ))
      }
    </ul>
    <div class="intro-copy mx-auto mt-6 flex max-w-[1120px] items-center justify-between gap-6 px-5" style="--i:4">
      <p class="text-[15px] text-ink-3">
        Prevucite da vidite svih {bouquets.length}, dodirnite za više fotografija. <a href="/unikati/" class="font-semibold text-sage hover:underline">Svi unikati</a>
      </p>
      <div class="hidden shrink-0 gap-2 sm:flex">
        <button type="button" data-carousel="-1" aria-label="Prethodni aranžmani" class="grid size-11 place-items-center rounded-full text-ink shadow-[inset_0_0_0_1.5px_var(--color-line)] transition hover:shadow-[inset_0_0_0_1.5px_var(--color-ink)] disabled:opacity-30">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18 9 12l6-6" /></svg>
        </button>
        <button type="button" data-carousel="1" aria-label="Sledeći aranžmani" class="grid size-11 place-items-center rounded-full text-ink shadow-[inset_0_0_0_1.5px_var(--color-line)] transition hover:shadow-[inset_0_0_0_1.5px_var(--color-ink)] disabled:opacity-30">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const row = document.querySelector<HTMLElement>("[data-track-row]")!;
  const paddles = [...document.querySelectorAll<HTMLButtonElement>("[data-carousel]")];
  const sync = () => {
    paddles[0].disabled = row.scrollLeft < 8;
    paddles[1].disabled = row.scrollLeft > row.scrollWidth - row.clientWidth - 8;
  };
  paddles.forEach((btn) =>
    btn.addEventListener("click", () => row.scrollBy({ left: Number(btn.dataset.carousel) * row.clientWidth * 0.75, behavior: "smooth" })),
  );
  row.addEventListener("scroll", sync, { passive: true });
  sync();
</script>
