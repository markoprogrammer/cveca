---
import Channels from "./Channels.astro";

interface Props {
  mode?: "firma" | "poklon";
}
const { mode = "firma" } = Astro.props;
import { CONTACT, SIZES, din } from "../data/site";
---

<!-- Contact: the guided message comes first. It writes the whole inquiry, and the visitor sends it
     by Viber, SMS, WhatsApp or email. Calling or writing directly are the alternatives below it. -->
<section id="upit" class="py-24 sm:py-36">
  <div class="mx-auto max-w-[1120px] px-5">
    <div class="text-center">
      <h2 data-reveal class="t-h2">Javite mi se<span class="dot">.</span></h2>
      <p class="t-intro mx-auto mt-5 max-w-[600px]">
        Popunite kratak upit i <strong>složiću vam poruku sa svim detaljima</strong>. Vi je samo pošaljite, preko aplikacije koju inače koristite.
      </p>
    </div>

    <div id="upit-forma" class="mx-auto mt-12 max-w-[820px] scroll-mt-24 rounded-[32px] bg-white p-6 shadow-[inset_0_0_0_1.5px_var(--color-line)] sm:mt-16 sm:p-11">
      <p class="text-[21px] font-bold tracking-[-0.03em]">Složite poruku</p>
      <p class="mt-1 text-[15px] text-ink-2">Popunite upit, a poruku zatim pošaljite Viberom, SMS-om, WhatsApp-om ili mejlom.</p>

      <form id="upit-form" class="mt-8">
        <fieldset class="seg relative grid grid-cols-2 rounded-full bg-lilac-2 p-1">
          <legend class="sr-only">Za koga je upit</legend>
          <span class="seg-pill absolute inset-y-1 left-1 w-[calc(50%-4px)] rounded-full bg-white shadow-[0_1px_4px_rgb(29_16_34/0.12)]" aria-hidden="true"></span>
          <label class="relative z-10 cursor-pointer py-2.5 text-center text-[15px] font-semibold text-ink-2 has-[:checked]:text-plum has-[:focus-visible]:underline">
            <input type="radio" name="mode" value="firma" checked={mode === "firma"} class="sr-only" />
            Za firmu
          </label>
          <label class="relative z-10 cursor-pointer py-2.5 text-center text-[15px] font-semibold text-ink-2 has-[:checked]:text-plum has-[:focus-visible]:underline">
            <input type="radio" name="mode" value="poklon" checked={mode === "poklon"} class="sr-only" />
            Za poklon
          </label>
        </fieldset>

        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <div class="fl sm:col-span-2">
            <input id="f-name" name="name" required autocomplete="name" placeholder=" " class="fl-input" />
            <label for="f-name" class="fl-label">Ime i prezime</label>
          </div>
          <div class="fl">
            <input id="f-phone" name="phone" type="tel" required autocomplete="tel" placeholder=" " class="fl-input" />
            <label for="f-phone" class="fl-label">Telefon</label>
          </div>
          <div class="fl">
            <input id="f-email" name="email" type="email" autocomplete="email" placeholder=" " class="fl-input" />
            <label for="f-email" class="fl-label">Email (nije obavezno)</label>
          </div>
        </div>

        <fieldset data-for="firma" class="mt-3 grid gap-3 sm:grid-cols-2">
          <legend class="sr-only">Podaci o firmi</legend>
          <div class="fl">
            <input id="f-company" name="company" required autocomplete="organization" placeholder=" " class="fl-input" />
            <label for="f-company" class="fl-label">Naziv firme</label>
          </div>
          <div class="fl">
            <input id="f-address" name="address" autocomplete="street-address" placeholder=" " class="fl-input" />
            <label for="f-address" class="fl-label">Adresa za dostavu</label>
          </div>
          <p class="mt-5 text-[16px] font-bold sm:col-span-2">Veličina</p>
          <div class="grid grid-cols-3 gap-3 sm:col-span-2">
            {
              SIZES.map((s) => (
                <label class="tile-pick p-4 text-center">
                  <input type="radio" name="size" value={s.id} checked={s.popular} data-price={din(s.price)} class="sr-only" />
                  <span class="block text-[24px] font-bold leading-none tracking-[-0.03em]">{s.id}</span>
                  <span class="mt-2 block text-[13px] tabular-nums text-ink-2">{din(s.price)} din</span>
                </label>
              ))
            }
          </div>
          <label class="mt-2 flex cursor-pointer items-center gap-3 sm:col-span-2">
            <input type="checkbox" name="trial" class="size-5 accent-plum" />
            <span class="text-[16px]">Želim prvo probnu isporuku</span>
          </label>
        </fieldset>

        <fieldset data-for="poklon" class="mt-3 grid gap-3">
          <legend class="sr-only">Podaci o poklonu</legend>
          <!-- Pickup first and large: it decides where and how, so it should not be a small afterthought. -->
          <div class="grid grid-cols-2 gap-3">
            <label class="tile-pick flex min-h-[84px] flex-col justify-center gap-1 px-4 py-3.5">
              <input type="radio" name="pickup" value="Preuzimam lično" checked class="sr-only" />
              <span class="text-[16px] font-semibold leading-tight">Preuzimam lično</span>
              <span class="text-[13px] leading-snug text-ink-2">Žarkovo, {CONTACT.street}</span>
            </label>
            <label class="tile-pick flex min-h-[84px] flex-col justify-center gap-1 px-4 py-3.5">
              <input type="radio" name="pickup" value="Dostava (po dogovoru)" class="sr-only" />
              <span class="text-[16px] font-semibold leading-tight">Dostava</span>
              <span class="text-[13px] leading-snug text-ink-2">Po dogovoru</span>
            </label>
          </div>
          <div class="grid grid-cols-[1.4fr_1fr] gap-3">
            <div class="fl">
              <input id="f-date" name="date" type="date" required placeholder=" " class="fl-input" />
              <label for="f-date" class="fl-label">Datum</label>
            </div>
            <div class="fl">
              <input id="f-time" name="time" type="time" placeholder=" " class="fl-input" />
              <label for="f-time" class="fl-label">Vreme (okvirno)</label>
            </div>
          </div>
          <div class="fl">
            <input id="f-occasion" name="occasion" placeholder=" " class="fl-input" />
            <label for="f-occasion" class="fl-label">Za koga je i povod (nije obavezno)</label>
          </div>
          <p class="text-[15px] text-ink-2">Poklon aranžmane pravim najmanje 48 sati unapred.</p>
        </fieldset>

        <div class="fl mt-3">
          <textarea id="f-message" name="message" rows="4" placeholder=" " class="fl-input"></textarea>
          <label for="f-message" class="fl-label">Poruka (nije obavezno)</label>
        </div>

        <button type="submit" class="btn btn-primary mt-8 w-full">Složi poruku</button>
        <p class="mt-3 text-center text-[13px] text-ink-3">Ništa se ne šalje samo: poruku prvo vidite, a šaljete je vi.</p>

        <div data-done hidden class="mt-6 rounded-[24px] bg-lilac p-6 sm:p-7">
          <p class="text-[17px] font-bold">Vaša poruka je spremna.</p>
          <p class="mt-1 text-[15px] text-ink-2">Pošaljite je preko Vibera, SMS-a, WhatsApp-a ili mejlom:</p>
          <pre data-preview class="mt-4 max-h-64 overflow-auto whitespace-pre-wrap rounded-[16px] bg-white p-4 font-sans text-[15px] leading-relaxed text-ink"></pre>
          <div class="mt-5"><Channels form /></div>
          <p class="mt-4 text-[15px] text-ink-2">
            <button type="button" data-copy class="font-semibold text-plum hover:underline">Kopiraj tekst</button>
            <span data-copy-note class="ml-1"></span>
          </p>
        </div>
      </form>
    </div>

    <p class="mt-14 text-center text-[15px] text-ink-3">Radije direktno?</p>
    <div class="mx-auto mt-5 grid max-w-[820px] gap-4 md:grid-cols-2">
      <div class="flex flex-col rounded-[28px] bg-lilac p-7 sm:p-8">
        <span class="text-[15px] text-ink-2">Pozovite</span>
        <a href={CONTACT.phoneHref} class="mt-1 w-fit text-[34px] font-bold leading-tight tracking-[-0.035em] tabular-nums transition-colors hover:text-plum">{CONTACT.phone}</a>
        <a href={CONTACT.phoneHref} class="btn btn-ghost mt-6 w-fit bg-white md:mt-auto">
          <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" /></svg>
          Pozovite
        </a>
      </div>
      <div class="rounded-[28px] bg-white p-7 shadow-[inset_0_0_0_1.5px_var(--color-line)] sm:p-8">
        <span class="text-[15px] text-ink-2">Pišite direktno</span>
        <div class="mt-4"><Channels /></div>
        <p class="mt-6 text-[13px] text-ink-2">
          {CONTACT.email}<br />
          Preuzimanje: {CONTACT.street}, {CONTACT.neighborhood}.{" "}
          <a href={CONTACT.maps} target="_blank" rel="noopener" class="font-semibold text-plum hover:underline">Mapa</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { CONTACT } from "../data/site";

  const form = document.querySelector<HTMLFormElement>("#upit-form")!;
  const date = form.querySelector<HTMLInputElement>('input[name="date"]')!;
  const done = form.querySelector<HTMLElement>("[data-done]")!;
  const preview = form.querySelector<HTMLElement>("[data-preview]")!;
  const send = (channel: string) => form.querySelector<HTMLAnchorElement>(`[data-send="${channel}"]`)!;
  const copy = form.querySelector<HTMLButtonElement>("[data-copy]")!;
  const copyNote = form.querySelector<HTMLElement>("[data-copy-note]")!;

  // Hidden fieldsets are disabled too, so their required fields don't block the visible ones.
  const mode = () => (new FormData(form).get("mode") === "poklon" ? "poklon" : "firma");
  const sync = () => form.querySelectorAll<HTMLFieldSetElement>("fieldset[data-for]").forEach((f) => (f.disabled = f.dataset.for !== mode()));
  sync();
  form.addEventListener("change", (e) => {
    if ((e.target as HTMLInputElement).name === "mode") sync();
  });

  // Any "Izaberi L" / "pošaljite upit" link elsewhere opens the form and preselects it.
  document.addEventListener("click", (e) => {
    const link = (e.target as Element).closest<HTMLElement>("[data-mode]");
    if (!link) return;
    form.querySelector<HTMLInputElement>(`input[name="mode"][value="${link.dataset.mode}"]`)!.checked = true;
    if (link.dataset.size) form.querySelector<HTMLInputElement>(`input[name="size"][value="${link.dataset.size}"]`)!.checked = true;
    if ("trial" in link.dataset) form.querySelector<HTMLInputElement>('input[name="trial"]')!.checked = true;
    sync();
  });

  // Gifts need 48 hours: the earliest date is the day after tomorrow, in local time.
  const earliest = new Date(Date.now() + 48 * 3600 * 1000);
  const pad = (n: number) => String(n).padStart(2, "0");
  date.min = `${earliest.getFullYear()}-${pad(earliest.getMonth() + 1)}-${pad(earliest.getDate())}`;
  date.addEventListener("input", () => {
    date.setCustomValidity(date.value && date.value < date.min ? "Poklon aranžmane pravim najmanje 48 sati unapred." : "");
  });

  const formatDate = (iso: string) => {
    const [y, m, d] = iso.split("-");
    return `${Number(d)}. ${Number(m)}. ${y}.`;
  };

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const v = (k: string) => String(data.get(k) ?? "").trim();
    const lines = [`Ime i prezime: ${v("name")}`, `Telefon: ${v("phone")}`];
    if (v("email")) lines.push(`Email: ${v("email")}`);
    let subject: string;
    if (mode() === "firma") {
      const size = form.querySelector<HTMLInputElement>('input[name="size"]:checked');
      subject = `Upit za firmu: ${v("company")}`;
      lines.push("", "Redovna dostava za firmu", `Firma: ${v("company")}`);
      if (v("address")) lines.push(`Adresa: ${v("address")}`);
      lines.push(`Veličina: ${size?.value} (${size?.dataset.price} din po isporuci)`);
      if (data.get("trial")) lines.push("Želim prvo probnu isporuku.");
    } else {
      subject = `Poklon aranžman za ${formatDate(v("date"))}`;
      lines.push("", "Poklon aranžman", `Datum: ${formatDate(v("date"))}`);
      if (v("time")) lines.push(`Vreme: ${v("time")}`);
      lines.push(`Preuzimanje: ${v("pickup")}`);
      if (v("occasion")) lines.push(`Kome i povodom čega: ${v("occasion")}`);
    }
    if (v("message")) lines.push("", v("message"));
    const message = lines.join("\n");
    const text = `${subject}\n\n${message}`;
    preview.textContent = text;
    send("mail").href = `mailto:${CONTACT.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(message)}`;
    send("whatsapp").href = `${CONTACT.whatsapp}?text=${encodeURIComponent(text)}`;
    // Viber's draft parameter is honoured by recent apps only; the click handler below also copies the text.
    send("viber").href = `${CONTACT.viber}&draft=${encodeURIComponent(text)}`;
    // "?&body=" is the form both iOS and Android accept.
    send("sms").href = `${CONTACT.sms}?&body=${encodeURIComponent(text)}`;
    copy.textContent = "Kopiraj tekst";
    copyNote.textContent = "";
    done.hidden = false;
    done.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });

  copy.addEventListener("click", async () => {
    await navigator.clipboard.writeText(preview.textContent ?? "");
    copy.textContent = "Kopirano ✓";
  });

  // Copy before opening Viber, so the text is one paste away if the app ignores the draft.
  send("viber").addEventListener("click", () => {
    navigator.clipboard.writeText(preview.textContent ?? "").catch(() => {});
    copyNote.textContent = "Tekst je kopiran: ako se ne pojavi u Viberu, samo ga nalepite.";
  });
</script>
