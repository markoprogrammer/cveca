---
// An image the browser must not fetch up front. Native loading="lazy" still downloads
// everything within ~2000px of the viewport, which on a slow phone steals bandwidth from the
// hero photo. src/scripts/animations.ts fills in src/srcset after the page has loaded
// (defer="load") or once the image is about a screen away (defer="view"), then fades it in.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  quality?: number;
  defer?: "load" | "view";
  style?: string;
}

const { src, alt, widths, sizes, class: className, quality, defer = "view", style } = Astro.props;
const img = await getImage({ src, widths, sizes, format: "webp", quality });
---

<img
  data-defer={defer}
  data-src={img.src}
  data-srcset={img.srcSet.attribute}
  sizes={sizes}
  alt={alt}
  width={img.attributes.width}
  height={img.attributes.height}
  decoding="async"
  class:list={["deferred", className]}
  style={style}
/>
<noscript><img src={img.src} srcset={img.srcSet.attribute} sizes={sizes} alt={alt} class={className} style={style} /></noscript>
