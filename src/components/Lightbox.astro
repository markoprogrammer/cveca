---
import { Image } from "astro:assets";
import type { Bouquet } from "../data/bouquets";
import { CONTACT } from "../data/site";

interface Props {
  b: Bouquet;
}
const { b } = Astro.props;
---

<dialog id={b.id} class="sheet" aria-label={b.title}>
  <div class="panel">
    <div class="relative min-h-0 bg-lilac">
      <div data-track class="no-scrollbar flex h-full snap-x snap-mandatory overflow-x-auto">
        {
          b.photos.map((p, i) => (
            <div class="flex h-full w-full shrink-0 snap-center items-center justify-center p-3 sm:p-6">
              <Image
                src={p}
                alt={`${b.title}, fotografija ${i + 1}`}
                widths={[640, 1000, 1400]}
                sizes="(min-width: 1024px) 760px, 100vw"
                format="webp"
                loading="lazy"
                data-slide={i}
                class="block h-auto max-h-full w-auto max-w-full rounded-[16px] object-contain"
              />
            </div>
          ))
        }
      </div>
      <button type="button" data-step="-1" aria-label="Prethodna fotografija" class="glass absolute left-4 top-1/2 hidden size-11 -translate-y-1/2 place-items-center rounded-full text-ink shadow-[0_2px_12px_rgb(0_0_0/0.15)] transition-opacity disabled:opacity-0 sm:grid">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18 9 12l6-6" /></svg>
      </button>
      <button type="button" data-step="1" aria-label="Sledeća fotografija" class="glass absolute right-4 top-1/2 hidden size-11 -translate-y-1/2 place-items-center rounded-full text-ink shadow-[0_2px_12px_rgb(0_0_0/0.15)] transition-opacity disabled:opacity-0 sm:grid">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
      </button>
      <button type="button" data-close aria-label="Zatvori" class="glass absolute right-3 top-3 grid size-9 place-items-center rounded-full text-ink shadow lg:hidden">
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>

    <aside class="flex min-h-0 flex-col overflow-y-auto p-6 sm:p-9">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-[13px] font-semibold uppercase tracking-[0.02em] text-ink-3">{b.vessel}</p>
          <h2 class="t-h3 mt-1">{b.title}</h2>
        </div>
        <button type="button" data-close aria-label="Zatvori" class="hidden size-9 shrink-0 place-items-center rounded-full bg-lilac-2 text-ink transition-colors hover:bg-orchid lg:grid">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </div>
      <p class="mt-2 text-[17px] text-ink-2">{b.flowers}</p>
      <p data-counter class="mt-4 text-[13px] tabular-nums text-ink-3 lg:mt-8">1 / {b.photos.length}</p>
      <div class="mt-3 hidden grid-cols-5 gap-2 lg:grid">
        {
          b.photos.map((p, i) => (
            <button type="button" data-thumb={i} aria-label={`Fotografija ${i + 1}`} aria-current={i === 0 ? "true" : "false"} class="aspect-square overflow-hidden rounded-[10px] opacity-50 ring-2 ring-transparent ring-offset-2 transition hover:opacity-100 aria-[current=true]:opacity-100 aria-[current=true]:ring-plum">
              <Image src={p} alt="" width={160} format="webp" loading="lazy" class="size-full object-cover" />
            </button>
          ))
        }
      </div>
      <div class="mt-5 lg:mt-auto lg:pt-8">
        <p class="hidden text-[15px] text-ink-2 lg:block">Svaki aranžman pravim samo jednom. Recite mi za koga je, a ja ću složiti novi, samo za vas.</p>
        <a href={CONTACT.phoneHref} class="btn btn-primary mt-4 w-full lg:mt-5">Pozovite i naručite</a>
        <a href="#upit" data-mode="poklon" data-dismiss class="link mt-3 w-full justify-center">ili pošaljite upit</a>
      </div>
    </aside>
  </div>
</dialog>

<script>
  // One script for every bouquet dialog. The clicked photo (a hero studio shot or a gallery close-up)
  // morphs into the matching slide with a view transition where supported; otherwise the panel scales in (CSS).
  const canMorph = "startViewTransition" in document && !matchMedia("(prefers-reduced-motion: reduce)").matches;

  function morph(from: HTMLElement, to: HTMLElement, change: () => void) {
    from.style.viewTransitionName = "morph";
    const t = document.startViewTransition(() => {
      from.style.viewTransitionName = "";
      to.style.viewTransitionName = "morph";
      change();
    });
    t.finished.finally(() => (to.style.viewTransitionName = ""));
  }

  for (const dialog of document.querySelectorAll<HTMLDialogElement>("dialog.sheet")) {
    const track = dialog.querySelector<HTMLElement>("[data-track]")!;
    const slides = [...dialog.querySelectorAll<HTMLImageElement>("img[data-slide]")];
    const thumbs = [...dialog.querySelectorAll<HTMLButtonElement>("[data-thumb]")];
    const counter = dialog.querySelector<HTMLElement>("[data-counter]")!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-step="-1"]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-step="1"]')!;
    const total = slides.length;
    let active = 0;
    let origin: { image: HTMLImageElement; index: number } | null = null;

    const render = () => {
      counter.textContent = `${active + 1} / ${total}`;
      thumbs.forEach((t, i) => t.setAttribute("aria-current", String(i === active)));
      prev.disabled = active === 0;
      next.disabled = active === total - 1;
    };
    const go = (i: number) => track.scrollTo({ left: Math.max(0, Math.min(total - 1, i)) * track.clientWidth, behavior: "smooth" });
    const jump = (i: number) => {
      track.scrollTo({ left: i * track.clientWidth, behavior: "instant" });
      active = i;
      render();
    };

    track.addEventListener("scroll", () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      if (i !== active) {
        active = i;
        render();
      }
    }, { passive: true });
    thumbs.forEach((t, i) => t.addEventListener("click", () => go(i)));
    prev.addEventListener("click", () => go(active - 1));
    next.addEventListener("click", () => go(active + 1));

    for (const card of document.querySelectorAll<HTMLButtonElement>(`[data-open="${dialog.id}"]`)) {
      const index = Number(card.dataset.index ?? 0);
      const image = card.querySelector("img");
      const target = slides[index];
      // Warm the matching slide while the pointer is on the card, so the morph lands on a decoded image.
      card.addEventListener("pointerenter", () => (target.loading = "eager"), { once: true });
      card.addEventListener("click", async () => {
        if (image?.dataset.src) {
          image.srcset = image.dataset.srcset ?? "";
          image.src = image.dataset.src;
          delete image.dataset.src;
          image.classList.add("is-loaded");
        }
        origin = image ? { image, index } : null;
        if (!canMorph || !image) {
          dialog.showModal();
          jump(index);
          return;
        }
        target.loading = "eager";
        await Promise.race([target.decode().catch(() => {}), new Promise((r) => setTimeout(r, 350))]);
        dialog.dataset.vt = "";
        morph(image, target, () => {
          dialog.showModal();
          jump(index);
        });
      });
    }

    const close = () => {
      if (!canMorph || !origin || active !== origin.index) {
        dialog.close();
        return;
      }
      morph(slides[active], origin.image, () => dialog.close());
    };

    dialog.addEventListener("close", () => delete dialog.dataset.vt);
    dialog.addEventListener("cancel", (e) => {
      e.preventDefault();
      close();
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") go(active + 1);
      if (e.key === "ArrowLeft") go(active - 1);
    });
    dialog.querySelectorAll("[data-close]").forEach((b) => b.addEventListener("click", close));
    dialog.querySelector("[data-dismiss]")?.addEventListener("click", () => dialog.close());
  }
</script>
