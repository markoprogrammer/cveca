---
// Ceca's logo: a "C" of lily stems and the script "veca" (src/data/logo.ts, traced from her Instagram logo).
// draw (header, home page opening): the logo writes itself. A mask of pen strokes uncovers the lines in
// the order they were drawn, from the big lily down the stem and on through "veca"; the stamens open
// once the lilies are outlined. The header holds the shapes once (defs); the footer copy reuses them.
import { LOGO } from "../data/logo";

interface Props {
  class?: string;
  tone?: "light" | "dark";
  draw?: boolean;
  /** Only the first logo on the page (the header) carries the shapes; later ones point to them. */
  defs?: boolean;
}
const { class: className = "", tone = "light", draw = false, defs = true } = Astro.props;
const ink = tone === "dark" ? "#c4d4c1" : "#4d6650";
const gold = tone === "dark" ? "#e2b552" : "#c99a2e";
// The pen starts a moment after the first paint and takes this long.
const start = 0.1;
const pen = 1;
const s = (t: number) => `${(start + t * pen).toFixed(3)}s`;
const [vx, vy, vw, vh] = LOGO.viewBox.split(" ").map(Number);
---

<svg
  viewBox={LOGO.viewBox}
  class:list={["logo", draw && "logo-draw", className]}
  style={draw ? `--pen-end:${s(1)};--gold-at:${s(LOGO.goldAt)}` : undefined}
  aria-hidden="true"
>
  {
    defs && (
      <defs>
        <path id="logo-lines" transform={LOGO.lines.transform} d={LOGO.lines.d} vector-effect="non-scaling-stroke" />
        <path id="logo-gold" transform={LOGO.gold.transform} d={LOGO.gold.d} vector-effect="non-scaling-stroke" />
      </defs>
    )
  }
  {
    draw && (
      <mask id="logo-pen" maskUnits="userSpaceOnUse" x={vx} y={vy} width={vw} height={vh}>
        <g fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round">
          {LOGO.strokes.map(([d, w, a, b]) => (
            <path d={d} stroke-width={w + 6} pathLength="1" style={`--a:${s(a)};--b:${Math.max(0.01, (b - a) * pen).toFixed(3)}s`} />
          ))}
        </g>
        <rect class="logo-done" x={vx} y={vy} width={vw} height={vh} fill="#fff" />
      </mask>
    )
  }
  <!-- A third of a pixel of outline on screen, at any size, so the hairlines hold up in a 56px header. -->
  <g mask={draw ? "url(#logo-pen)" : undefined} class="logo-ink"><use href="#logo-lines" fill={ink} stroke={ink} stroke-width="0.65" /></g>
  <use href="#logo-gold" fill={gold} stroke={gold} stroke-width="0.4" class="logo-gold" />
</svg>
