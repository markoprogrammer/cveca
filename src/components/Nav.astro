---
import Logo from "./Logo.astro";
import { CONTACT } from "../data/site";

interface Props {
  intro?: boolean;
  contact?: string;
}
const { intro = false, contact = "#upit" } = Astro.props;
const here = Astro.url.pathname;
const links = [
  { href: "/unikati/", label: "Unikati" },
  { href: "/cvece-za-firme/", label: "Za firme" },
  { href: "/poklon-aranzmani/", label: "Za poklon" },
  { href: "/#prica", label: "O meni" },
];
---

<header class="site-header sticky top-0 z-40 px-3 pt-3 sm:px-4">
  <nav class="liquid mx-auto flex h-16 max-w-[1144px] items-center gap-6 rounded-full pl-4 pr-3" aria-label="Glavna navigacija">
    <!-- The logo, and its tagline after it as on Ceca's logo (where there is room beside the menu). -->
    <a href={intro ? "#top" : "/"} class="flex shrink-0 items-center gap-3" aria-label={intro ? "Cveca, na vrh stranice" : "Cveca, početna"}>
      <Logo draw={intro} class:list={["h-14 w-auto", intro && "logo-fly"]} />
      <span class:list={["hidden translate-y-[12px] text-[13px] leading-none tracking-[0.02em] text-ink-3 sm:block lg:hidden xl:block", intro && "intro-tagline"]}>autorski cvetni aranžmani</span>
    </a>
    <ul class="ml-auto hidden items-center gap-7 lg:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} data-jump aria-current={here.startsWith(l.href) ? "page" : undefined} class="text-[14px] font-medium text-ink-2 transition-colors hover:text-sage aria-[current=page]:text-sage">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <!-- Two ways in, side by side: write (leads to Viber/SMS/WhatsApp/email in the contact section) or call. -->
    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <a href={contact} class="btn btn-ghost min-h-0 gap-2 px-4 py-2 text-[14px]">
        <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM9 11H7V9h2v2zm4 0h-2V9h2v2zm4 0h-2V9h2v2z" /></svg>
        Pišite
      </a>
      <a href={CONTACT.phoneHref} class="btn btn-soft min-h-0 gap-2 px-4 py-2 text-[14px]">
        <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" /></svg>
        <span class="sm:hidden">Pozovite</span>
        <span class="hidden tabular-nums sm:inline">{CONTACT.phone}</span>
      </a>
    </div>
  </nav>
</header>

