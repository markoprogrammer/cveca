---
import Logo from "./Logo.astro";
import { CONTACT } from "../data/site";

const links = [
  { href: "#unikati", label: "Unikati" },
  { href: "#firme", label: "Za firme" },
  { href: "#poklon", label: "Za poklon" },
  { href: "#prica", label: "O meni" },
  { href: "#upit", label: "Kontakt" },
];
---

<header class="glass sticky top-0 z-40 border-b border-hairline">
  <nav class="mx-auto flex h-16 max-w-[1120px] items-center gap-8 px-5" aria-label="Glavna navigacija">
    <a href="#top" class="shrink-0 [&:hover_.logo-bloom]:rotate-[72deg]" aria-label="Cveca, na vrh stranice"><Logo bloom /></a>
    <ul class="ml-auto hidden items-center gap-7 lg:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="text-[14px] font-medium text-ink-2 transition-colors hover:text-plum">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={CONTACT.phoneHref} class="btn btn-soft ml-auto min-h-0 gap-2 px-4 py-2 text-[14px] lg:ml-0">
      <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" /></svg>
      <span class="sm:hidden">Pozovite</span>
      <span class="hidden tabular-nums sm:inline">{CONTACT.phone}</span>
    </a>
  </nav>
</header>
