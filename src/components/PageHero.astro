---
// Opening block of an inner page: breadcrumbs, label, the page's h1, intro (slot) and a photo in an arch.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import type { Crumb } from "../data/seo";

interface Props {
  crumbs: Crumb[];
  tag: string;
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { crumbs, tag, title, image, imageAlt = "" } = Astro.props;
---

<section class="pb-16 pt-10 sm:pb-24 sm:pt-14">
  <div class="mx-auto grid max-w-[1120px] items-center gap-12 px-5 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
    <div>
      <Breadcrumbs items={crumbs} />
      <p class="tag">{tag}</p>
      <h1 data-reveal class="t-h2 mt-4">{title}</h1>
      <p class="t-intro mt-6 max-w-[560px]"><slot /></p>
    </div>
    {
      image && (
        <div data-reveal="photo" class="arch mx-auto w-full max-w-[440px] overflow-hidden">
          <Image src={image} alt={imageAlt} widths={[440, 660, 880]} sizes="(min-width: 1024px) 440px, 90vw" format="webp" loading="eager" fetchpriority="high" class="arch block aspect-[4/5] w-full object-cover" />
        </div>
      )
    }
  </div>
</section>
