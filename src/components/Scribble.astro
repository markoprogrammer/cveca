---
// A coral stroke drawn under a word, as if Ceca underlined it by hand.
// It draws itself on load (draw="load") or when the word scrolls into view (default).
interface Props {
  draw?: "load" | "view";
}
const { draw = "view" } = Astro.props;
---

<span class:list={["scribble", `scribble-${draw}`]} data-scribble={draw === "view" ? "" : undefined}>
  <slot />
  <svg viewBox="0 0 100 16" preserveAspectRatio="none" aria-hidden="true">
    <path pathLength="1" d="M3 11.5C22 6.5 47 4.6 72 5.4c9 .3 17 1.2 24 2.6M30 13.4c16-2.2 34-3 52-2.2" />
  </svg>
</span>
