---
import { Image } from "astro:assets";
import hands from "../assets/proces/dsc_7574.jpg";
import detail from "../assets/proces/dsc_7572.jpg";
import Bloom from "./Bloom.astro";
import Wordmark from "./Wordmark.astro";

// Ceca's own story, word for word as she wrote it. Words turn from grey to ink as the paragraphs scroll
// through (src/scripts/animations.ts), across both paragraphs.
const story = [
  "Nedavno smo se moja prijateljica Tanja i ja spremale za proslavu kod drugarice. Želele smo da joj poklonimo nešto posebno. Tanja se bavi grnčarijom, pa je predložila da ja napravim cvetni aranžman u šolji koju je ona napravila.",
  "Ja nesigurno odlazim na pijacu, da kupim cveće, jer ne želim da izdam Tanju, ali sam u ozbiljnom strahu kako ću ja to, nikada nisam to radila. Kupujem cveće i u nekom trenutku idem prema autu, sa gomilom cveća u naručju i više ne osećam strah, već uzbuđenje, jedva čekam da stignem kući i bacim se u akciju. Nisam imala pojma kako će ispasti, ali sam svaki cvetić birala i nežno raspoređivala baš tamo gde mi se najviše dopadalo i ispalo je sjajno…",
];
---

<section id="prica" class="py-24 sm:py-40">
  <div class="mx-auto max-w-[1120px] px-5">
    <!-- "ceca" turns into the logo as it scrolls up: the letters part, the v sprouts, the flower opens. -->
    <h2 data-reveal class="t-h2 max-w-[900px]">Ja sam Ceca. Kad se udružim sa cvećem, postajem <Wordmark><span class="dot">.</span></Wordmark></h2>

    <!-- A stem grows beside the story as it is read, and the flower opens on "…ispalo je sjajno…" -->
    <div data-story class="relative mt-16 sm:mt-24 lg:pl-20">
      <svg class="stem pointer-events-none absolute -top-4 bottom-0 left-0 hidden w-14 lg:block" viewBox="0 0 56 600" preserveAspectRatio="none" aria-hidden="true">
        <path pathLength="1" d="M28 0C14 70 42 130 28 200S12 330 28 400s16 140 0 200" />
        <path pathLength="1" d="M27 150c10-14 22-18 26-16-3 12-14 20-26 16z" />
        <path pathLength="1" d="M29 300c-10-14-22-18-26-16 3 12 14 20 26 16z" />
        <path pathLength="1" d="M27 460c10-14 22-18 26-16-3 12-14 20-26 16z" />
      </svg>
      {
        story.map((paragraph, p) => (
          <p data-words class:list={["max-w-[980px] text-[clamp(25px,3vw,40px)] font-semibold leading-[1.24] tracking-[-0.028em]", p > 0 && "mt-[0.9em]"]}>
            {paragraph.split(" ").map((w) => (
              <>
                <span>{w}</span>{" "}
              </>
            ))}
            {p === story.length - 1 && <Bloom open="view" class="inline-block size-[1.05em] -translate-y-[0.08em] align-middle" />}
          </p>
        ))
      }
    </div>

    <div class="mt-20 grid gap-5 sm:mt-28 md:grid-cols-2">
      <div data-reveal="photo" class="arch overflow-hidden">
        <Image
          src={hands}
          alt="Cecine ruke slažu sedum i eustomu u aranžman"
          widths={[480, 720, 1060]}
          sizes="(min-width: 768px) 530px, 100vw"
          format="webp" quality={72}
          data-parallax
          class="arch block aspect-[4/5] w-full scale-110 object-cover"
        />
      </div>
      <div class="flex flex-col gap-5">
        <div class="flex flex-1 flex-col justify-between rounded-[32px] bg-mist p-8 sm:p-10">
          <p class="t-intro">
            <strong>Nisam školovani cvećar i ne pratim pravila.</strong> Ne pravim buket po slici i ne kopiram nikoga. Aranžmanu dajem potpunu slobodu,
            zato je svaki unikat i zato ovakve nema u cvećarama.
          </p>
          <figure class="mt-10">
            <blockquote class="text-[clamp(22px,2.4vw,28px)] font-semibold leading-tight tracking-[-0.02em]">
              „Ovo je najlepše cveće koje sam ikada dobila.”
            </blockquote>
            <figcaption class="mt-3 text-[15px] text-ink-2">Rečenica koju sam čula od više žena koje su dobile moje bukete.</figcaption>
          </figure>
        </div>
        <div data-reveal="photo" class="hidden overflow-hidden rounded-[28px] md:block">
          <Image src={detail} alt="Ruka postavlja sedum među gladiole i eustomu" widths={[530, 1060]} sizes="530px" format="webp" class="block aspect-[16/9] w-full object-cover" />
        </div>
      </div>
    </div>
  </div>
</section>
