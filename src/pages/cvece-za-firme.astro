---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Business from "../components/Business.astro";
import Faq from "../components/Faq.astro";
import Inquiry from "../components/Inquiry.astro";
import hero from "../assets/buketi/buket-06/dsc_7528.jpg";
import { breadcrumbs, businessService } from "../data/seo";
import { FAQ, din } from "../data/site";

const crumbs = [
  { name: "Početna", path: "/" },
  { name: "Cveće za firme", path: "/cvece-za-firme/" },
];



const faq = [
  ...FAQ.filter((f) => f.q.includes("firm")),
  { q: "Mogu li prvo da probam?", a: "Možete. Zakažite jednu probnu isporuku i vidite kako vaš prostor izgleda sa cvećem, pa odlučite o redovnoj saradnji." },
  { q: "Koju veličinu da izaberem?", a: `M (${din(5500)} din) je za manju recepciju, šalter ili sto; L (${din(7500)} din) za recepciju, hol ili veći prostor; XL (${din(10500)} din) za veliki prostor, hotel ili restoran. Ako niste sigurni, pozovite me pa ćemo zajedno proceniti.` },
];
---

<Base
  schema
  title="Cveće za firme u Beogradu · nedeljna dostava aranžmana | Cveca"
  description="Svakog ponedeljka nov, svež cvetni aranžman na vašoj recepciji u Beogradu. Stari odnosim sa posudom, plaćanje preko računa. Od 5.500 din po isporuci."
  jsonLd={[breadcrumbs(crumbs), businessService]}
>
  <PageHero crumbs={crumbs} tag="Cveće za firme · Beograd" title="Cveće za firme u Beogradu" image={hero} imageAlt="Aranžman sa zevalicama, hrizantemama i eustomom u keramičkoj vazi">
    Svakog ponedeljka donosim nov, svež aranžman na vašu recepciju i odnosim stari zajedno sa posudom. <strong>Vaš prostor je svake nedelje drugačiji</strong>,
    a vi ne brinete ni o čemu.
  </PageHero>

  <Business />
  <Faq items={faq} title="Pitanja firmi" />
  <Inquiry mode="firma" />
</Base>
