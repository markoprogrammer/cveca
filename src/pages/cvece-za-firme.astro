---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Business from "../components/Business.astro";
import Faq from "../components/Faq.astro";
import hero from "../assets/buketi/buket-06/dsc_7528.jpg";
import { breadcrumbs, businessService } from "../data/seo";
import { FAQ, SIZES, din } from "../data/site";

const crumbs = [
  { name: "Početna", path: "/" },
  { name: "Cveće za firme", path: "/cvece-za-firme/" },
];

// "Ljubičica (mali aranžman, 4.500 din) je za recepciju, pult ili radni sto; Lala (…) za …"
const sizeGuide = SIZES.map(
  (s, i) => `${s.name} (${s.kind.toLowerCase()}, ${din(s.price)} din)${i === 0 ? " je" : ""} ${s.space.charAt(0).toLowerCase()}${s.space.slice(1)}`,
).join("; ");

const faq = [
  ...FAQ.filter((f) => f.q.includes("firm")),
  { q: "Mogu li prvo da probam?", a: "Možete. Probu dogovaramo po povoljnijoj ceni, pa vidite kako vaš prostor izgleda sa cvećem i odlučite o redovnoj saradnji." },
  { q: "Koju veličinu da izaberem?", a: `${sizeGuide}. Ako niste sigurni, pozovite me pa ćemo zajedno proceniti.` },
];
---

<Base
  schema
  title="Cveće za firme u Beogradu · nedeljna dostava aranžmana | Cveca"
  description={`Svakog ponedeljka nov, svež cvetni aranžman na vašoj recepciji u Beogradu. Stari odnosim sa posudom, plaćanje preko računa. Od ${din(SIZES[0].price)} din po isporuci.`}
  jsonLd={[breadcrumbs(crumbs), businessService]}
  contact="/?upit=firma#upit"
>
  <PageHero crumbs={crumbs} tag="Cveće za firme · Beograd" title="Cveće za firme u Beogradu" image={hero} imageAlt="Aranžman sa zevalicama, hrizantemama i eustomom u keramičkoj vazi">
    Svakog ponedeljka donosim nov, svež aranžman na vašu recepciju i odnosim stari zajedno sa posudom. <strong>Vaš prostor je svake nedelje drugačiji</strong>,
    a vi ne brinete ni o čemu.
  </PageHero>

  <Business />
  <Faq items={faq} title="Pitanja firmi" />
</Base>
