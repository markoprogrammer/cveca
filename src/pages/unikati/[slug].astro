---
import { Image, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Lightbox from "../../components/Lightbox.astro";
import Inquiry from "../../components/Inquiry.astro";
import { bouquets, neighbours, type Bouquet } from "../../data/bouquets";
import { breadcrumbs } from "../../data/seo";
import { CONTACT } from "../../data/site";

export function getStaticPaths() {
  return bouquets.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}

const { b } = Astro.props as { b: Bouquet };
const { prev, next } = neighbours(b);
const path = `/unikati/${b.slug}/`;
const crumbs = [
  { name: "Početna", path: "/" },
  { name: "Unikati", path: "/unikati/" },
  { name: b.title, path },
];
const og = await getImage({ src: b.photos[0], width: 1200, format: "jpg" });
const flowers = b.flowers.split(", ");
---

<Base
  schema
  title={`${b.title} · aranžman ${b.vessel.toLowerCase()} | Cveca, Beograd`}
  description={`${b.title}, ${b.vessel.toLowerCase()}: ${b.flowers.toLowerCase()}. Unikatni cvetni aranžman od sezonskog cveća, Žarkovo, Beograd.`}
  image={og.src}
  jsonLd={[breadcrumbs(crumbs)]}
>
  <section class="pb-24 pt-10 sm:pb-32 sm:pt-14">
    <div class="mx-auto max-w-[1120px] px-5">
      <Breadcrumbs items={crumbs} />
      <div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
        <div>
          <button type="button" data-open={b.id} data-index="0" aria-label={`${b.title}, sve fotografije`} class="group block w-full">
            <span class="arch block overflow-hidden bg-lilac">
              <Image
                src={b.photos[0]}
                alt={`${b.title}, ${b.vessel.toLowerCase()}: ${b.flowers.toLowerCase()}`}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 500px, 92vw"
                format="webp"
                loading="eager"
                fetchpriority="high"
                class="arch block aspect-[2/3] w-full object-cover transition-transform duration-[1200ms] ease-out-expo group-hover:scale-[1.02]"
              />
            </span>
          </button>
        </div>

        <div class="lg:pt-6">
          <p class="tag">{b.vessel}</p>
          <h1 data-reveal class="t-h2 mt-4">{b.title}<span class="dot">.</span></h1>
          <p class="t-intro mt-6">{b.description}</p>

          <h2 class="mt-10 text-[15px] font-semibold text-ink-2">U njemu</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {flowers.map((f) => <li class="rounded-full px-4 py-2 text-[15px] shadow-[inset_0_0_0_1.5px_var(--color-line)]">{f}</li>)}
          </ul>

          <h2 class="mt-10 text-[15px] font-semibold text-ink-2">Fotografije</h2>
          <ul class="mt-3 grid grid-cols-4 gap-2 sm:grid-cols-5">
            {
              b.photos.map((p, i) => (
                <li>
                  <button type="button" data-open={b.id} data-index={i} aria-label={`Fotografija ${i + 1}`} class="block aspect-square w-full overflow-hidden rounded-[12px] bg-lilac">
                    <Image src={p} alt="" width={200} format="webp" class="size-full object-cover transition-transform duration-500 hover:scale-105" />
                  </button>
                </li>
              ))
            }
          </ul>

          <div class="mt-12 rounded-[28px] bg-lilac p-7 sm:p-8">
            <p class="text-[21px] font-bold tracking-[-0.02em]">Želite nešto u ovom duhu?</p>
            <p class="mt-2 text-[17px] text-ink-2">
              Ovaj aranžman više ne postoji, i to je njegova lepota. Recite mi za koga je i koje boje voli, a ja ću složiti novi, samo za vas.
            </p>
            <div class="mt-6 flex flex-wrap items-center gap-x-7 gap-y-4">
              <a href={CONTACT.phoneHref} class="btn btn-primary">Pozovite i naručite</a>
              <a href="#upit" data-mode="poklon" class="link">ili pošaljite upit</a>
            </div>
          </div>
        </div>
      </div>

      <nav aria-label="Ostali unikati" class="mt-20 flex items-center justify-between gap-6 border-t border-line pt-8 text-[17px]">
        <a href={`/unikati/${prev.slug}/`} class="font-semibold transition-colors hover:text-plum">← {prev.title}</a>
        <a href="/unikati/" class="hidden text-ink-2 transition-colors hover:text-plum sm:inline">Svi unikati</a>
        <a href={`/unikati/${next.slug}/`} class="font-semibold transition-colors hover:text-plum">{next.title} →</a>
      </nav>
    </div>
  </section>

  <Inquiry mode="poklon" />
  <Lightbox b={b} />
</Base>
