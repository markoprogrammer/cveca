{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cveca",
  "compatibility_date": "2026-10-22",
  // Pure static site: Workers Static Assets serves dist/, no Worker script needed.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Served only on the real domain; www.cveca.rs redirects here via a Cloudflare redirect rule.
  "routes": [{ "pattern": "cveca.rs", "custom_domain": true }],
  // No *.workers.dev copy of the site, so search engines see a single address.
  "workers_dev": false,
  "preview_urls": false
}
